---
<Base
  title="Resources"
  description="Publications, talks, and media coverage from Open Scholar on open access, peer review, and research evaluation."
>
  <section class="section wrap">
    <p class="kicker" data-reveal>The record</p>
    <h1 class="display res__title" data-reveal style="animation-delay:.1s">Resources</h1>
    <p class="res__intro" data-reveal style="animation-delay:.2s">
      Peer-reviewed publications, talks, and press connected to Open Scholar,
      going back to 2006. A long argument, made in many places.
    </p>
  </section>

  <section class="wrap res__section">
    <p class="kicker">Publications</p>
    <ol class="bib">
      {publications.map((p) => (
        <li class="bib__item">
          <span class="bib__year">{p.year}</span>
          <span class="bib__cite">
            <span set:html={p.cite} />
            {p.href && <> <a href={p.href} class="inline-link bib__link" rel="noopener">link ↗</a></>}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap res__section">
    <p class="kicker">Presentations &amp; workshops</p>
    <ol class="bib">
      {talks.map((t) => (
        <li class="bib__item">
          <span class="bib__year">{t.year}</span>
          <span class="bib__cite">
            {t.href ? <a href={t.href} class="inline-link" rel="noopener">{t.text}</a> : <span>{t.text}</span>}
            {t.links && t.links.map((l) => (<> · <a href={l.href} class="inline-link bib__link" rel="noopener">{l.label} ↗</a></>))}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap res__section">
    <p class="kicker">In the media</p>
    <ol class="bib">
      {media.map((m) => (
        <li class="bib__item">
          <span class="bib__year">{m.year}</span>
          <span class="bib__cite">
            <a href={m.href} class="inline-link" rel="noopener" set:html={m.text} />
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .res__title { font-size: clamp(2.6rem, 7vw, 5rem); }
  .res__intro { max-width: 40rem; font-size: 1.15rem; color: var(--ink-soft); margin-top: 1.2rem; }
  .res__section { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .bib { list-style: none; margin: 1.2rem 0 0; padding: 0; border-top: 1px solid var(--line); max-width: 54rem; }
  .bib__item { display: grid; grid-template-columns: 4rem 1fr; gap: 1.2rem; padding: 1rem 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .bib__year { color: var(--petrol); font-size: 0.8rem; font-weight: 600; }
  .bib__cite { line-height: 1.5; }
  .bib__cite :global(em) { font-style: italic; color: var(--ink-soft); }
  .bib__link { font-size: 0.8rem; white-space: nowrap; }
  @media (max-width: 560px) { .bib__item { grid-template-columns: 1fr; gap: 0.3rem; } }
</style>
