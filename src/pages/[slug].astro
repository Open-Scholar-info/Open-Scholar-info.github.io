---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.data.title} description={post.data.title}>
  <article class="post section wrap">
    <header class="post__head">
      <p class="kicker">
        From the archive
        <span class="post__date">{fmt(post.data.date)}</span>
      </p>
      <h1 class="post__title">{post.data.title}</h1>
    </header>

    {post.data.image ? (
      <img src={post.data.image} alt="" class="post__hero" loading="eager" />
    ) : (
      <div class="hr keyrule"></div>
    )}

    <div class="post__body prose">
      <Content />
    </div>

    <footer class="post__foot">
      <a href="/news/" class="inline-link mono">← News archive</a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 46rem; }
  .post__hero { width: 100%; border-radius: 10px; border: 1px solid var(--line); margin: 1.5rem 0 0.5rem; aspect-ratio: 16 / 8; object-fit: cover; }
  .post__head { margin-bottom: 0; }
  .post__date { color: var(--muted); border: 0; }
  .kicker .post__date::before { content: "·"; margin: 0 0.5em; color: var(--line-strong); }
  .post__title {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.4rem);
    font-weight: 440;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0;
  }
  .post__body { font-size: 1.18rem; }
  .post__body :global(h2) { font-size: 1.7rem; }
  .post__body :global(a) {
    color: var(--petrol);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(26,108,122,0.4);
  }
  .post__foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
  }
</style>
