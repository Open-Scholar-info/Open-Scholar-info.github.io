---
import Base from '../layouts/Base.astro';
import { founders, workingTeam } from '../data/team';

const timeline = [
  { year: '2012', text: 'Founded, and LIBRE launched: our first prototype for open, community-led evaluation.' },
  { year: '2013', text: 'The Independent Peer Review Manifesto sets out our common vision.' },
  { year: '2014–17', text: 'The Open Peer Review Module is built with a five-partner consortium, funded by OpenAIRE.' },
  { year: '2017–20', text: 'Work with COAR on Next Generation Repositories.' },
  { year: '2019', text: 'Psicológica moves into DIGITAL.CSIC — a journal running entirely on a repository.' },
  { year: '2021', text: 'The Notify project begins, carrying the ideas into shared infrastructure.' },
];
---
<Base
  title="About"
  description="Open Scholar is a group of academics working for open, fair, and transparent scholarship since 2012."
>
  <section class="section wrap">
    <p class="kicker" data-reveal>About</p>
    <h1 class="display about__title" data-reveal style="animation-delay:.1s">What is Open Scholar?</h1>
  </section>

  <section class="wrap about__body">
    <div class="prose">
      <p class="about__lead">
        Open Scholar is a group of active academics who believe that Science
        deserves a more efficient, ethical, and transparent system of
        communication, validation and evaluation.
      </p>
      <p>
        Our mission is to develop ideas and tools that promote open and
        transparent scientific collaboration for a faster, more efficient and
        natural organisation, evaluation and dissemination of global knowledge.
        We are a project-based group: we run several parallel projects, and each
        of us is free to decide where, when, and how to contribute.
      </p>
      <p>
        We began in 2012 as a Community Interest Company, registered in the
        United Kingdom. Keeping that legal structure proved costly, and some
        years ago we let it go. Open Scholar has no formal legal status today.
        It is a volunteer collective that runs projects, seeks no funding, and
        carries the name forward as a record of what we have done and a home for
        what comes next. If a real reason appears — a funding opportunity, for
        instance — we may seek non-profit status again, in Spain or elsewhere.
      </p>
      <p>
        We are not an organisation you join, but we have never been closed.
        Anyone who shares the goals is welcome to write, compare notes, and look
        for ways of working together.
      </p>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <p class="kicker">The trajectory</p>
      <ol class="tl">
        {timeline.map((t) => (
          <li class="tl__item">
            <span class="tl__year">{t.year}</span>
            <span class="tl__text">{t.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="team" class="section wrap">
    <p class="kicker">Founders</p>
    <div class="team">
      {founders.map((m) => (
        <article class="member">
          {m.image && <img src={m.image} alt={m.name} class="member__photo" loading="lazy" />}
          <h3 class="member__name">{m.name}</h3>
          <p class="member__role">{m.role}</p>
          {m.bio && <p class="member__bio">{m.bio}</p>}
          {m.link && <a href={m.link} class="inline-link member__link" rel="noopener">Website →</a>}
        </article>
      ))}
    </div>

    <p class="kicker team__k2">Working team</p>
    <div class="team team--compact">
      {workingTeam.map((m) => (
        <article class="member member--sm">
          {m.image && <img src={m.image} alt={m.name} class="member__photo" loading="lazy" />}
          <h3 class="member__name">{m.name}</h3>
          <p class="member__role">{m.role}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .about__title { font-size: clamp(2.4rem, 6vw, 4.4rem); }
  .about__body { padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .about__lead { font-size: clamp(1.25rem, 1.2vw + 1rem, 1.7rem); font-weight: 500; line-height: 1.34; color: var(--ink); }
  .prose p:not(.about__lead) { color: var(--ink-soft); }
  .tl { list-style: none; margin: 1.5rem 0 0; padding: 0; max-width: 50rem; }
  .tl__item { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; align-items: baseline; padding: 1.1rem 0; border-top: 1px solid var(--line); }
  .tl__item:last-child { border-bottom: 1px solid var(--line); }
  .tl__year { color: var(--petrol); font-size: 0.85rem; font-weight: 600; }
  .tl__text { color: var(--ink); }
  .team { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-top: 1.5rem; }
  @media (min-width: 640px) { .team { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 920px) { .team { grid-template-columns: repeat(3, 1fr); } }
  .team__k2 { margin-top: 3.5rem; }
  .team--compact { gap: 1.5rem 2rem; }
  @media (min-width: 640px) { .team--compact { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 920px) { .team--compact { grid-template-columns: repeat(4, 1fr); } }
  .member__photo { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--line); margin-bottom: 1rem; }
  .member--sm .member__photo { width: 78px; height: 78px; }
  .member__name { font-size: 1.3rem; margin: 0; }
  .member--sm .member__name { font-size: 1.1rem; }
  .member__role { color: var(--petrol); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin: 0.2rem 0 0.6rem; }
  .member__bio { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }
  .member__link { font-size: 0.85rem; display: inline-block; margin-top: 0.6rem; }
  @media (max-width: 540px) { .tl__item { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
