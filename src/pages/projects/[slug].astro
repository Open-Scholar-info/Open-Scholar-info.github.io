---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <article class="pp section wrap">
    <header class="pp__head">
      <p class="kicker">
        {d.status === 'active' ? 'Active project' : 'Foundational work'}
        <span class="pp__span">{d.span}</span>
      </p>
      <h1 class="pp__title">{d.title}</h1>
      {d.partners && <p class="pp__partners">{d.partners}</p>}
    </header>

    {!d.video && d.image && (
      <img src={d.image} alt="" class="pp__hero" loading="eager" />
    )}

    {d.video && (
      <div class="pp__video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${d.video}`}
          title={`${d.title} — video`}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="pp__body prose">
      <Content />
    </div>

    {d.link && (
      <a href={d.link.href} class="btn pp__link" rel="noopener">{d.link.label} →</a>
    )}

    <footer class="pp__foot">
      <a href="/projects/" class="inline-link">← All projects</a>
      <a href="mailto:info@openscholar.info" class="inline-link">Get in touch →</a>
    </footer>
  </article>
</Base>

<style>
  .pp { max-width: 46rem; }
  .pp__head .kicker { display: flex; align-items: center; }
  .pp__span { color: var(--muted); }
  .pp__span::before { content: "·"; margin: 0 0.6em; color: var(--line-strong); }
  .pp__title { font-size: clamp(2rem, 4vw + 0.5rem, 3.2rem); font-weight: 700; letter-spacing: -0.03em; margin: 0; }
  .pp__partners { color: var(--ink-soft); margin-top: 0.4rem; }
  .pp__note {
    margin: 1.8rem 0; padding: 1rem 1.2rem;
    background: var(--bg-2); border-left: 3px solid var(--petrol);
    color: var(--ink-soft); font-size: 0.95rem; border-radius: 0 6px 6px 0;
  }
  .pp__hero { width: 100%; aspect-ratio: 16 / 8; object-fit: contain; background: var(--bg-2); border-radius: 10px; border: 1px solid var(--line); margin: 2rem 0 0; }
  .pp__video {
    position: relative; margin: 2rem 0 0; aspect-ratio: 16 / 9;
    border-radius: 10px; overflow: hidden; border: 1px solid var(--line);
  }
  .pp__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pp__body { margin-top: 2rem; }
  .pp__body :global(h2) { font-size: 1.5rem; margin-top: 2em; }
  .pp__body :global(h3) { font-size: 1.15rem; margin-top: 1.8em; color: var(--petrol); }
  .pp__link { margin-top: 2rem; }
  .pp__foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
</style>
