---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// group by year
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', day: '2-digit' });
---
<Base
  title="News archive"
  description="The full Open Scholar archive — announcements, reports, and essays since 2011."
>
  <section class="section wrap">
    <p class="kicker" data-reveal>News</p>
    <h1 class="display nw__title" data-reveal style="animation-delay:.1s">Archive</h1>
    <p class="nw__intro prose" data-reveal style="animation-delay:.2s">
      The complete run of announcements, conference reports, and essays, kept
      intact as a history of these efforts. Some entries are well over a decade
      old. They are here on purpose.
    </p>
  </section>

  <section class="wrap section nw__list">
    {years.map((year) => (
      <div class="yearblock">
        <h2 class="yearblock__year">{year}</h2>
        <ul class="items">
          {byYear.get(year)!.map((p) => (
            <li>
              <a href={`/${p.id}/`} class="item">
                {p.data.image
                  ? <img src={p.data.image} alt="" class="item__thumb" loading="lazy" />
                  : <span class="item__thumb item__thumb--empty"></span>}
                <span class="item__date mono">{fmt(p.data.date)}</span>
                <span class="item__title">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  .nw__title { max-width: 12ch; }
  .nw__intro { max-width: 42rem; font-size: 1.2rem; color: var(--ink-soft); margin-top: 1.5rem; }

  .yearblock {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    padding-top: 2.5rem;
    margin-top: 2.5rem;
    border-top: 1.5px solid var(--ink);
  }
  .yearblock:first-child { margin-top: 0; }
  .yearblock__year {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--petrol);
    margin: 0;
    position: sticky;
    top: 5rem;
    align-self: start;
  }
  .items { list-style: none; margin: 0; padding: 0; }
  .item {
    display: grid;
    grid-template-columns: 3.2rem 4.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.2s;
  }
  .item:first-child { border-top: 1px solid var(--line); }
  .item:hover { padding-left: 0.6rem; }
  .item__thumb { width: 3.2rem; height: 2.4rem; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); }
  .item__thumb--empty { background: var(--bg-2); }
  .item__date { color: var(--muted); font-size: 0.72rem; }
  .item__title { font-size: 1.15rem; line-height: 1.25; }
  .item:hover .item__title { color: var(--petrol); }
  .item__tag { color: var(--rust); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; }

  @media (max-width: 640px) {
    .yearblock { grid-template-columns: 1fr; gap: 0.5rem; }
    .yearblock__year { position: static; }
    .item { grid-template-columns: 3.2rem 1fr; }
    .item__date { display: none; }
    .item__tag { display: none; }
  }
</style>
