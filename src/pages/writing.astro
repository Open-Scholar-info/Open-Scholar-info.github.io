---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('posts'))
  .filter((p) => p.data.kind === 'essay' && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---
<Base
  title="Writing"
  description="Essays from Open Scholar on peer review, evaluation, and the future of scholarly publishing."
>
  <section class="section wrap">
    <p class="kicker" data-reveal>Writing</p>
    <h1 class="display wr__title" data-reveal style="animation-delay:.1s">Essays</h1>
    <p class="wr__intro prose" data-reveal style="animation-delay:.2s">
      Longer pieces on peer review, research evaluation, and where scholarly
      publishing might go. Many are years old and have aged well — the problems
      they describe are still with us. For dated announcements and reports, see
      the <a href="/news/" class="inline-link">news archive</a>.
    </p>
  </section>

  <section class="wrap section">
    <ul class="essaylist">
      {essays.map((e) => (
        <li>
          <a href={`/${e.id}/`} class="ess">
            {e.data.image
              ? <img src={e.data.image} alt="" class="ess__thumb" loading="lazy" />
              : <span class="ess__thumb ess__thumb--empty"><img src="/images/favicon.png" alt="" /></span>}
            <span class="ess__body">
              <span class="ess__date mono">{fmt(e.data.date)}</span>
              <span class="ess__title">{e.data.title}</span>
            </span>
            <span class="ess__go mono">Read →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .wr__title { font-size: clamp(3rem, 9vw, 7rem); }
  .wr__intro { max-width: 42rem; font-size: 1.2rem; color: var(--ink-soft); margin-top: 1.5rem; }
  .essaylist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ess {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.25s;
  }
  .ess:hover { padding-left: 0.6rem; }
  .ess__thumb { width: 7rem; height: 4.6rem; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); flex: none; }
  .ess__thumb--empty { display: flex; align-items: center; justify-content: center; background: var(--bg-2); }
  .ess__thumb--empty img { width: 1.8rem; height: 1.8rem; opacity: 0.5; }
  .ess__body { display: flex; flex-direction: column; gap: 0.25rem; }
  .ess__date { color: var(--muted); font-size: 0.74rem; }
  .ess__title { font-size: clamp(1.2rem, 1.4vw + 0.6rem, 1.7rem); line-height: 1.18; }
  .ess:hover .ess__title { color: var(--petrol); }
  .ess__go { color: var(--petrol); font-size: 0.74rem; opacity: 0; transition: opacity 0.2s; }
  .ess:hover .ess__go { opacity: 1; }
  @media (max-width: 640px) {
    .ess { grid-template-columns: 5rem 1fr; gap: 1rem; }
    .ess__thumb { width: 5rem; height: 3.6rem; }
    .ess__go { display: none; }
  }
</style>
