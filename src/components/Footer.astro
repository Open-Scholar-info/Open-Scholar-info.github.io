---
const year = new Date().getFullYear();
---
<footer class="foot tint">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <img src="/images/os-vertical.png" alt="Open Scholar" class="foot__logo" width="256" height="249" />
      <p class="foot__tag">An independent group of academics working for open, fair, and transparent scholarship.</p>
    </div>

    <nav class="foot__col" aria-label="Site">
      <span class="foot__h">Explore</span>
      <a href="/about/">About</a>
      <a href="/manifesto/">Manifesto</a>
      <a href="/projects/">Projects</a>
      <a href="/news/">News archive</a>
    </nav>

    <nav class="foot__col" aria-label="Work">
      <span class="foot__h">More</span>
      <a href="/resources/">Resources</a>
      <a href="https://www.psicologicajournal.com" rel="noopener">Psicológica</a>
      <a href="mailto:info@openscholar.info">info@openscholar.info</a>
    </nav>
  </div>

  <div class="wrap foot__base">
    <span>© 2012–{year} Open Scholar</span>
    <a href="mailto:info@openscholar.info">info@openscholar.info</a>
  </div>
</footer>

<style>
  .foot { padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: 2rem; margin-top: auto; border-top: 1px solid var(--line); }
  .foot__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); padding-bottom: 2.5rem; }
  .foot__logo { width: 84px; height: auto; }
  .foot__tag { max-width: 24rem; margin-top: 1.2rem; color: var(--ink-soft); font-size: 0.95rem; }
  .foot__h { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--petrol); margin-bottom: 1rem; }
  .foot__col { display: flex; flex-direction: column; gap: 0.6rem; }
  .foot__col a { color: var(--ink-soft); font-size: 0.92rem; transition: color 0.2s; }
  .foot__col a:hover { color: var(--petrol); }
  .foot__base {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-top: 1.5rem; border-top: 1px solid var(--line);
    font-size: 0.74rem; color: var(--muted);
  }
  @media (max-width: 720px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
  }
</style>
